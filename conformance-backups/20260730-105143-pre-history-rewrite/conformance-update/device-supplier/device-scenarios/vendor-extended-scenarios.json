            "serialNumber": "SN-GPU-0001",
            "roles": ["Standalone Device"],
            "resources": {
              "cpu": { "cores": 16, "architecture": "amd64" },
              "memory": "64Gi",
              "storage": "1Ti",
              "interfaces": [{ "type": "ethernet" }],
              "peripherals": [
                { "type": "gpu", "manufacturer": "NVIDIA", "model": "Jetson" },
                { "type": "display" },
                { "type": "camera" }
              ]
            }
          }
        },
        "headers": {},
        "expected_status": 201,
        "validations": [
          { "field": "status", "operation": "equals", "value": "capabilities_received" }
        ],
        "extract_context": {},
        "skip_signing": false
