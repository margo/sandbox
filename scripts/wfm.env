# Environment variables for the Margo pipeline

# GitHub credentials
# Leave blank for public Margo repos; set these only if accessing private repositories.
export GITHUB_USER=""
export GITHUB_TOKEN=""

# Harbor registry configuration
# Set EXPOSED_HARBOR_HOST to the hostname or IP address of your Harbor machine.
# If the hostname does not resolve inside Docker containers (DNS issue), use the IP address directly.
# Example: export EXPOSED_HARBOR_HOST=10.139.9.90
export EXPOSED_HARBOR_HOST=harbor.machine
# Port 8443 is used for HTTPS access to Harbor (recommended).
# If your Harbor instance is configured for HTTP, use port 8081 and ensure Docker allows insecure registries.
export EXPOSED_HARBOR_PORT=8443

# Symphony service configuration
# Set EXPOSED_SYMPHONY_HOST to the hostname or IP address of your Symphony machine.
# If the hostname does not resolve in your environment, use the IP address directly.
# Example: export EXPOSED_SYMPHONY_HOST=10.139.9.91
export EXPOSED_SYMPHONY_HOST=symphony.machine
export EXPOSED_SYMPHONY_PORT=8082

# Git branches to use when cloning/building (a tag name is also accepted)
export SYMPHONY_BRANCH=main
export SANDBOX_REPO_BRANCH=main
