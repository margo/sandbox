  },
  {
    "id": "wfm-core-desired-state",
    "name": "Desired State — Retrieval, Content Negotiation, Digest-Addressed Fetches",
    "crIds": ["MARGO-WFM-MANAGEMENTINTERFACE-004", "MARGO-WFM-MANAGEMENTINTERFACE-006", "MARGO-WFM-MANAGEMENTINTERFACE-007", "MARGO-WFM-MANAGEMENTINTERFACE-008", "MARGO-WFM-MANAGEMENTINTERFACE-009", "MARGO-WFM-MANAGEMENTINTERFACE-014", "MARGO-WFM-MANAGEMENTINTERFACE-015", "MARGO-WFM-MANAGEMENTINTERFACE-025", "MARGO-WFM-MANAGEMENTINTERFACE-027", "MARGO-WFM-MANAGEMENTINTERFACE-030", "MARGO-WFM-MANAGEMENTINTERFACE-031", "MARGO-WFM-MANAGEMENTINTERFACE-034", "MARGO-WFM-MANAGEMENTINTERFACE-035", "MARGO-WFM-MANAGEMENTINTERFACE-038"],
    "description": "Covers GET /deployments (both with and without an explicit Accept header — MI-007 default-negotiation requirement) and, when a deployment happens to be assigned, the digest-addressed bundle/deployment-YAML fetches. Bundle/deployment fetches are conditional on deployments being non-empty (PRECONDITION, see wfm-multi-component group for the operator-assignment flow) so this group only asserts what's true unconditionally.",
    "steps": [
      {
        "id": "wfm-core-ds-1",
        "name": "Retrieve Desired State With Explicit Accept Header",
        "crIds": ["MARGO-WFM-MANAGEMENTINTERFACE-004", "MARGO-WFM-MANAGEMENTINTERFACE-006", "MARGO-WFM-MANAGEMENTINTERFACE-007", "MARGO-WFM-MANAGEMENTINTERFACE-027", "MARGO-WFM-MANAGEMENTINTERFACE-034"],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": { "Accept": "application/vnd.margo.manifest.v1+json" },
        "expected_status": 200,
        "validations": [
          { "field": "manifestVersion", "operation": "is_number" },
          { "field": "_headers.content-type", "operation": "equals", "value": "application/vnd.margo.manifest.v1+json" },
          { "field": "_headers.etag", "operation": "matches_regex", "value": "^\"?sha256:[0-9a-f]{64}\"?$" }
        ],
        "extract_context": {
          "manifestEtag": "_headers.etag",
          "bundleDigest": "bundle.digest",
          "deploymentId": "deployments.0.deploymentId",
          "deploymentDigest": "deployments.0.digest"
        }
      },
      {
        "id": "wfm-core-ds-2",
        "name": "Retrieve Desired State Without An Accept Header — Defaults To Manifest Media Type",
        "crIds": ["MARGO-WFM-MANAGEMENTINTERFACE-007"],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {},
        "expected_status": 200,
        "validations": [
          { "field": "_headers.content-type", "operation": "equals", "value": "application/vnd.margo.manifest.v1+json" }
        ],
        "extract_context": {}
      },
      {
        "id": "wfm-core-ds-3",
        "name": "Retrieve Desired State Again With Matching ETag — 304",
        "crIds": ["MARGO-WFM-MANAGEMENTINTERFACE-030"],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": { "Accept": "application/vnd.margo.manifest.v1+json", "If-None-Match": "{manifestEtag}" },
        "expected_status": 304,
        "validations": [],
        "extract_context": {}
      }
    ]
  },
  {
    "id": "wfm-core-status",
    "name": "Deployment Status Reporting",
    "crIds": ["MARGO-WFM-MANAGEMENTINTERFACE-021", "MARGO-WFM-MANAGEMENTINTERFACE-022", "MARGO-WFM-MANAGEMENTINTERFACE-041"],
    "description": "Reports status for a synthetic deployment ID — a real WFM will 4xx/track this against its own known deployments, so this asserts request-shape acceptance (status code + acknowledgement contract), not that the specific deploymentId is meaningful to the WFM under test.",
    "steps": [
      {
        "id": "wfm-core-status-1",
        "name": "Report Deployment Status",
        "method": "POST",
        "endpoint": "/api/v1/deployments/wfm-core-test-deployment/status",
        "mtls": true,
        "request_body": {
          "deploymentId": "wfm-core-test-deployment",
          "adoptedManifestVersion": 1,
          "status": { "state": "installed" },
          "components": [{ "name": "wfm-core-component-1", "state": "installed" }]
        },
        "headers": {},
        "expected_status": 200,
        "validations": [],
        "extract_context": {}
      }
    ]
  }
]
