[
  {
    "id": "wfm-core-capabilities",
    "name": "Device Capabilities — Report, Update, and Validation",
    "crIds": ["MARGO-WFM-MANAGEMENTINTERFACE-021", "MARGO-WFM-MANAGEMENTINTERFACE-022", "MARGO-WFM-MANAGEMENTINTERFACE-023", "MARGO-WFM-MANAGEMENTINTERFACE-041"],
    "description": "MIAF replacement for wfm-core/postman_collection.json's capabilities items (see CONFORMANCE_FLOWS_AND_MIAF_MIGRATION.md §7.2 — Postman can't present an mTLS client SVID, so this consolidated file is the all-declarative equivalent for the WFM-supplier persona going forward). No onboarding call (none exists under MIAF); capabilities is PUT-only (no more POST-then-PUT); no apiVersion/kind envelope.",
    "steps": [
      {
        "id": "wfm-core-cap-1",
        "name": "Report Device Capabilities (create)",
        "crIds": ["MARGO-WFM-MANAGEMENTINTERFACE-021", "MARGO-WFM-MANAGEMENTINTERFACE-022"],
        "method": "PUT",
        "endpoint": "/api/v1/capabilities/wfm-core-device",
        "mtls": true,
        "request_body": {
          "properties": {
            "id": "wfm-core-device",
            "vendor": "Conformance Test Suite",
            "modelNumber": "CTS-WFMCORE-1",
            "serialNumber": "SN-WFMCORE-001",
            "cpus": [{ "cores": 4, "architecture": "arm64" }],
            "memory": "16Gi",
            "storage": "256Gi",
            "interfaces": [{ "type": "ethernet" }],
            "peripherals": [],
            "otelCollector": false,
            "supportedRuntimes": ["oci"],
            "supportedDeploymentTypes": ["helm", "compose"]
          }
        },
        "headers": {},
        "expected_status": 201,
        "validations": [],
        "extract_context": {}
      },
      {
        "id": "wfm-core-cap-2",
        "name": "Update Device Capabilities (same deviceId, second call)",
        "crIds": ["MARGO-WFM-MANAGEMENTINTERFACE-021", "MARGO-WFM-MANAGEMENTINTERFACE-022", "MARGO-WFM-MANAGEMENTINTERFACE-041"],
        "method": "PUT",
        "endpoint": "/api/v1/capabilities/wfm-core-device",
        "mtls": true,
        "request_body": {
          "properties": {
            "id": "wfm-core-device",
            "vendor": "Conformance Test Suite",
            "modelNumber": "CTS-WFMCORE-1",
            "serialNumber": "SN-WFMCORE-001",
            "cpus": [{ "cores": 8, "architecture": "amd64" }],
            "memory": "32Gi",
            "storage": "512Gi",
            "interfaces": [{ "type": "ethernet" }, { "type": "wifi" }],
            "peripherals": [],
            "otelCollector": false,
            "supportedRuntimes": ["oci"],
            "supportedDeploymentTypes": ["helm", "compose"]
          }
        },
        "headers": {},
        "expected_status": 200,
        "validations": [],
        "extract_context": {}
      },
      {
        "id": "wfm-core-cap-3",
        "name": "Reject Capabilities — Invalid supportedDeploymentTypes",
        "crIds": ["MARGO-WFM-MANAGEMENTINTERFACE-023"],
        "method": "PUT",
        "endpoint": "/api/v1/capabilities/wfm-core-device",
        "mtls": true,
