    "crIds": [
      "MARGO-WFM-MANAGEMENTINTERFACE-MIAF-001"
    ],
    "description": "Verifies the WFM accepts an mTLS connection using a valid X.509-SVID (tb-1) and rejects connections sent without a client certificate (tb-2 — expect_transport_error: true). MIAF-002 (trust bundle distribution) is validated indirectly: tb-1 can only succeed if the CTT's SVID was issued by the same trust bundle the WFM trusts, proving the trust bundle is correctly installed. The MIS /spiffe-bundle endpoint is not part of the WFM SBI and is not tested here. See docs/CONFORMANCE_FLOWS_AND_MIAF_MIGRATION.md §4.",
    "steps": [
      {
        "id": "wfm-identity-tb-1",
        "name": "WFM Accepts mTLS Connection With Valid SVID",
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-MIAF-001"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "_headers.content-type",
            "operation": "equals",
            "value": "application/vnd.margo.manifest.v1+json"
          }
        ],
        "extract_context": {}
      },
      {
        "id": "wfm-identity-tb-2",
        "name": "WFM Rejects Connection Without Client Certificate",
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-MIAF-001"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": false,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 0,
        "expect_transport_error": true,
        "validations": [],
        "extract_context": {}
      }
    ]
  },
