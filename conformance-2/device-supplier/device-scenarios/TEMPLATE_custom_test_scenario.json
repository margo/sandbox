[
  {
    "id": "scenario-custom-example",
    "name": "Custom Test Scenario Example",
    "description": "This is a template showing how to create your own test scenarios",
    "steps": [
      {
        "id": "step-1.1",
        "name": "First API Call - Device Onboarding",
        "method": "POST",
        "endpoint": "/api/v1/onboarding",
        "request_body": {
          "apiVersion": "onboarding.margo.org/v1alpha1",
          "kind": "OnboardingRequest",
          "certificate": "./certs/device-cert.pem"
        },
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 201,
        "validations": [
          {
            "field": "clientId",
            "operation": "is_string"
          },
          {
            "field": "status",
            "operation": "exists"
          }
        ],
        "extract_context": {
          "clientId": "clientId",
          "manifestEtag": "_headers.ETag"
        },
        "skip_signing": false,
        "skip_certificate_injection": false
      },
      {
        "id": "step-1.2",
        "name": "Second API Call - Get Capabilities",
        "method": "GET",
        "endpoint": "/api/v1/capabilities",
        "headers": {
          "Accept": "application/vnd.margo.capabilities.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "capabilities",
            "operation": "is_array"
          }
        ],
        "skip_signing": false
      },
      {
        "id": "step-1.3",
        "name": "Third API Call - Negative Test (Expected Error)",
        "method": "POST",
        "endpoint": "/api/v1/deployments",
        "request_body": {
          "invalid": "payload"
        },
        "expected_status": 400,
        "validations": [
          {
            "field": "error",
            "operation": "contains",
            "value": "Invalid"
          }
        ]
      }
    ]
  },
  {
    "id": "scenario-custom-second",
    "name": "Your Second Custom Scenario",
    "description": "Template for creating a second independent test flow",
    "steps": [
      {
        "id": "step-2.1",
        "name": "First step of scenario 2",
        "method": "GET",
        "endpoint": "/api/v1/status",
        "expected_status": 200,
        "validations": [
          {
            "field": "state",
            "operation": "is_string"
          }
        ]
      }
    ]
  }
]
