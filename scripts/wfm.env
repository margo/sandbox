# GITHUB_USER and GITHUB_TOKEN can be skipped as Margo repos are public now
export GITHUB_USER="" 
export GITHUB_TOKEN="" 
export EXPOSED_HARBOR_HOST=harbor.machine #hostname or ip address
export EXPOSED_SYMPHONY_HOST=symphony.machine #hostname or ip address
# should follow "mis.(TrustDomain)" format, where TrustDomain will be reused for running MIS & minting x509 SVIDs via helper script.
export EXPOSED_MIS_HOST=mis.margo.org
export EXPOSED_MIS_PORT=9443
export EXPOSED_HARBOR_PORT=8443
export EXPOSED_SYMPHONY_PORT=8082   #8082 port is NBI,8084 we are referring to SBI (Margo Management Interface) port here
export SYMPHONY_BRANCH=main
export SANDBOX_REPO_BRANCH=main
