        "endpoint": "/api/v1/clients/{clientId}/deployments/c8e2d4b1-2b3c-5d4e-0f6a-7b8c9d0e1f2b/status",
        "request_body": {
          "apiVersion": "deployment.margo.org/v1alpha1",
          "kind": "DeploymentStatusManifest",
          "deploymentId": "c8e2d4b1-2b3c-5d4e-0f6a-7b8c9d0e1f2b",
          "status": { "state": "installing" },
